# Python bytecode (created when you run scripts)
__pycache__/
*.py[cod]
*$*.py

# Virtual environments (if you use them locally)
venv/
.venv/
env/

# Operating system files
.DS_Store
Thumbs.db

# Temporary Excel/Office files 
# (These are created when you have an Excel file open)
~$*.xlsx
~$*.xls
~$*.csv

# IDE folders
.vscode/
.idea/
